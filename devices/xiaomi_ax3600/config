#
# Xiaomi AX3600 (IPQ8071A, 512 MB) — the reference build.
#
# Concatenated onto devices/common/config by prepare-build.sh.
#

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

## The dedicated QCA9889 AIoT radio uses the QCA9887 ath10k-ct firmware
## package/driver. Enable it as a separate Wi-Fi 4 (802.11n) AP for legacy
## devices; the other two radios continue using ath11k with NSS offload.
## Enable LED support for the GPIO AIoT activity indicator.
CONFIG_ATH10K-CT_LEDS=y
CONFIG_PACKAGE_ath10k-board-qca9887=y
CONFIG_PACKAGE_ath10k-firmware-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=y
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y

## Hardware this board does not have.
CONFIG_PACKAGE_kmod-phy-aquantia=n

## Preinstalled packages from the existing AX3600 / Lorenzo configuration
## Libraries and kmods are resolved by OpenWrt; do not reuse the legacy
## qca-nss-drv/ECM modules on this upstream PPE-NSS build.

# DNS / DDNS
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y

# VPN clients and LuCI
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_openfortivpn=y
CONFIG_PACKAGE_luci-proto-openfortivpn=y

# LAN services
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_wifischedule=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# Prometheus exporters
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-hostapd_stations=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-hostapd_ubus_stations=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-nat_traffic=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi_stations=y

# Avahi required for the ESP32-C6/H2 Thread discovery topology.
# The matching working reflector config lives in the device's files overlay.
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y

# Diagnostics and management
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_openssl-util=y
