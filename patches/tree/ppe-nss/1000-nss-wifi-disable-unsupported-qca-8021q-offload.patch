+/* NSS knows physical switch ports through nss_flow_ifnum(). Stacked DSA
+ * ports require a QCA 802.1Q tagger and a VID translation which are absent
+ * from the current 6.18 target. Until upstream adds that tagger, never
+ * translate unknown DSA port traffic into an NSS offload rule.
+ * Existing registered Wi-Fi and wired interface paths remain supported.
+ */
+int nss_flow_port(struct nss_core *core, int ifindex, u16 flow_vid, u32 *mtu,
+                  u16 *vid)
+{
+	*vid = 0;
+	return nss_flow_ifnum(core, ifindex, mtu);
+}
